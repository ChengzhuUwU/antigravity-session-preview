{
  "name": "antigravity-session-preview",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "Lightweight real-time Session, Markdown, PDF & Office previewer plugin for Antigravity CLI and Antigravity 2.0 with 2x8 + multi-candidate Custom RGB themes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChengzhuUwU/antigravity-session-preview.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "agy-preview": "./bin/agy-preview.mjs"
  },
  "scripts": {
    "sync-vendor": "node scripts/sync-vendor.mjs",
    "install-plugin": "node scripts/install-plugin.mjs",
    "pack-plugin": "node scripts/pack-plugin.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node bin/agy-preview.mjs --open"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "docx-preview": "^0.3.7",
    "jszip": "^3.10.2",
    "katex": "^0.16.22",
    "marked": "^15.0.12",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "^0.18.5"
  }
}
